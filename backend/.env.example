# Google Gemini API key (required for /api/analyze)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection URI (leave empty to use local SQLite tasks.db)
DATABASE_URL=

# Slack OAuth — required for "Connect Slack" (Slack sign-in / workspace install)
# 1. https://api.slack.com/apps → Create New App → From scratch
# 2. OAuth & Permissions → Redirect URL:
#    http://127.0.0.1:8000/api/slack/oauth/callback
# 3. Bot Token Scopes: channels:history, channels:read, groups:history,
#    im:history, mpim:history, users:read
# 4. User Token Scopes (개인 로그인): identity.basic, identity.email, identity.avatar
# 5. Basic Information → copy Client ID & Client Secret below
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:8000/api/slack/oauth/callback
SLACK_OAUTH_SUCCESS_URL=http://localhost:3000/dashboard?slack=connected
SLACK_OAUTH_ERROR_URL=http://localhost:3000/?slack=error

# Optional: comma-separated bot scopes for OAuth install
# SLACK_BOT_SCOPES=channels:history,channels:read,groups:history,im:history,mpim:history,users:read
# SLACK_USER_SCOPES=identity.basic,identity.email,identity.avatar

# Optional: server-side bot token (Events API / users.info fallback — not used for Connect Slack UI)
# SLACK_BOT_TOKEN=xoxb-your-bot-token
